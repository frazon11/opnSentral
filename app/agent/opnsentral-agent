function execute_job(array $job, array $config): array
{
    $type = (string) ($job['type'] ?? '');
    if ($type === 'inventory') return ['hostname'=>hostname_value(),'opnsense_version'=>opnsense_version(),'architecture'=>php_uname('m'),'php_version'=>PHP_VERSION,'agent_version'=>AGENT_VERSION];
    if ($type === 'system_status') { $load = function_exists('sys_getloadavg') ? sys_getloadavg() : []; return ['hostname'=>hostname_value(),'load_average'=>is_array($load)?array_values($load):[],'uptime'=>trim((string)shell_exec('/usr/bin/uptime 2>/dev/null')),'root_bytes_total'=>@disk_total_space('/')?:null,'root_bytes_free'=>@disk_free_space('/')?:null,'checked_at'=>gmdate('c')]; }
    if ($type === 'set_administration_settings') return set_administration_settings(is_array($job['payload'] ?? null) ? $job['payload'] : []);
    if ($type === 'set_general_settings') return set_general_settings(is_array($job['payload'] ?? null) ? $job['payload'] : []);
    if ($type === 'set_firewall_advanced_settings') return set_firewall_advanced_settings(is_array($job['payload'] ?? null) ? $job['payload'] : []);
    if ($type === 'set_access_user') return set_access_user(is_array($job['payload'] ?? null) ? $job['payload'] : []);
    if ($type === 'ssh_access_status') return ssh_access_status();
    if ($type === 'ensure_ssh_access') return ensure_ssh_access(is_array($job['payload'] ?? null) ? $job['payload'] : []);
    if ($type === 'self_update') return self_update($config, is_array($job['payload'] ?? null) ? $job['payload'] : []);
    throw new RuntimeException('Unsupported job type: ' . $type);
}

function schedule_self_restart(): void { shell_exec("/bin/sh -c '(sleep 2; /usr/sbin/service opnsentral_agent restart) >/dev/null 2>&1 &' >/dev/null 2>&1"); }

function poll_job(array $config): void
{
    $response = signed_post($config, '/api/agent_jobs.php', []); $job = $response['job'] ?? null; if (!is_array($job)) return; $jobId = (int) ($job['id'] ?? 0); if ($jobId <= 0) return;
    try { $result = execute_job($job, $config); $restart = ($result['_restart_agent'] ?? false) === true; unset($result['_restart_agent']); signed_post($config, '/api/agent_job_result.php', ['job_id'=>$jobId,'success'=>true,'result'=>$result]); if ($restart) schedule_self_restart(); }
    catch (Throwable $exception) { signed_post($config, '/api/agent_job_result.php', ['job_id'=>$jobId,'success'=>false,'result'=>null,'error'=>$exception->getMessage()]); }
}

function run_once(array $config): void { report($config); poll_job($config); }

$command = $argv[1] ?? 'run';
if ($command === 'register') { if (count($argv) < 4) fail('Usage: opnsentral-agent register https://OPNSENTRAL TOKEN'); register_agent((string) $argv[2], (string) $argv[3]); exit(0); }
$config = load_config();
if ($command === 'once') { run_once($config); exit(0); }
if ($command !== 'run') fail('Supported commands: register, once, run');
$interval = max(30, (int) ($config['poll_interval'] ?? 60));
while (true) { try { run_once($config); } catch (Throwable $exception) { fwrite(STDERR, gmdate('c') . ' ' . $exception->getMessage() . "\n"); } sleep($interval); }
