#!/usr/local/bin/php
<?php

declare(strict_types=1);

const AGENT_VERSION = '0.1.13';
const CONFIG_PATH = '/usr/local/etc/opnsentral-agent.json';

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, "opnSentral agent: {$message}\n");
    exit($code);
}

function opnsense_version(): string
{
    foreach (['/usr/local/sbin/opnsense-version -a 2>/dev/null','/usr/local/sbin/opnsense-version 2>/dev/null','/usr/bin/uname -r 2>/dev/null'] as $command) {
        $output = trim((string)shell_exec($command));
        if ($output !== '') return substr($output, 0, 128);
    }
    return 'unknown';
}

function hostname_value(): string
{
    $hostname = gethostname();
    return is_string($hostname) && $hostname !== '' ? $hostname : 'opnsense';
}

function json_body(array $payload): string
{
    return json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
}

function curl_binary(): string
{
    foreach (['/usr/local/bin/curl','/usr/bin/curl'] as $candidate) {
        if (is_file($candidate) && is_executable($candidate)) return $candidate;
    }
    $resolved = trim((string)shell_exec('command -v curl 2>/dev/null'));
    if ($resolved !== '' && is_executable($resolved)) return $resolved;
    throw new RuntimeException('curl is required but was not found on OPNsense.');
}

function run_process(array $command, ?string $stdin = null): array
{
    $process = proc_open($command, [0=>['pipe','r'],1=>['pipe','w'],2=>['pipe','w']], $pipes);
    if (!is_resource($process)) throw new RuntimeException('Could not start HTTPS client.');
    if ($stdin !== null && $stdin !== '') fwrite($pipes[0], $stdin);
    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]); fclose($pipes[2]);
    $status = proc_close($process);
    return ['status'=>$status,'stdout'=>is_string($stdout)?$stdout:'','stderr'=>is_string($stderr)?$stderr:''];
}

function curl_request(string $url, string $method='GET', ?string $body=null, array $headers=[], bool $verifyTls=true): string
{
    if (!preg_match('#^https://#i',$url)) throw new RuntimeException('Refusing non-HTTPS request: '.$url);
    $command=[curl_binary(),'--silent','--show-error','--location','--fail','--connect-timeout','10','--max-time','60','--proto','=https','--user-agent','opnSentral-agent/'.AGENT_VERSION];
    if (!$verifyTls) $command[]='--insecure';
    foreach ($headers as $header) { $command[]='--header'; $command[]=(string)$header; }
    if (strtoupper($method)==='POST') { $command[]='--request'; $command[]='POST'; $command[]='--data-binary'; $command[]='@-'; }
    $command[]=$url;
    $result=run_process($command,$body);
    if ((int)$result['status']!==0) {
        $detail=trim((string)$result['stderr']);
        if ($detail==='') $detail=trim((string)$result['stdout']);
        throw new RuntimeException('HTTPS request failed for '.$url.($detail!==''?': '.substr($detail,0,500):'.'));
    }
    return (string)$result['stdout'];
}

function http_post(string $url, string $body, array $headers, bool $verifyTls=true): array
{
    $response=curl_request($url,'POST',$body,array_merge(['Content-Type: application/json','Accept: application/json'],$headers),$verifyTls);
    $decoded=json_decode($response,true);
    if (!is_array($decoded)) throw new RuntimeException('Server returned invalid JSON.');
    if (($decoded['ok']??false)!==true) throw new RuntimeException((string)($decoded['error']??'Server rejected the request.'));
    return $decoded;
}

function load_config(): array
{
    if (!is_file(CONFIG_PATH)) fail('Not registered. Run: opnsentral-agent register SERVER_URL TOKEN');
    $decoded=json_decode((string)file_get_contents(CONFIG_PATH),true);
    if (!is_array($decoded)) fail('Configuration file is invalid.');
    foreach (['server_url','agent_id','agent_secret'] as $key) if (trim((string)($decoded[$key]??''))==='') fail('Configuration is missing '.$key.'.');
    return $decoded;
}

function save_config(array $config): void
{
    $directory=dirname(CONFIG_PATH);
    if (!is_dir($directory) && !mkdir($directory,0755,true) && !is_dir($directory)) fail('Could not create configuration directory.');
    if (file_put_contents(CONFIG_PATH,json_encode($config,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n",LOCK_EX)===false) fail('Could not write configuration.');
    chmod(CONFIG_PATH,0600);
}

function signed_post(array $config, string $path, array $payload): array
{
    $body=json_body($payload); $timestamp=(string)time(); $nonce=bin2hex(random_bytes(16));
    $canonical=$timestamp."\n".$nonce."\n".hash('sha256',$body);
    $signature=hash_hmac('sha256',$canonical,(string)$config['agent_secret']);
    return http_post(rtrim((string)$config['server_url'],'/').$path,$body,[
        'X-OpnSentral-Agent-ID: '.$config['agent_id'],
        'X-OpnSentral-Timestamp: '.$timestamp,
        'X-OpnSentral-Nonce: '.$nonce,
        'X-OpnSentral-Signature: '.$signature,
    ],($config['verify_tls']??true)!==false);
}

function registration_payload(string $token): array
{
    return ['token'=>$token,'hostname'=>hostname_value(),'opnsense_version'=>opnsense_version(),'architecture'=>php_uname('m'),'agent_version'=>AGENT_VERSION];
}

function register_agent(string $serverUrl, string $token): void
{
    $serverUrl=rtrim(trim($serverUrl),'/');
    if (!preg_match('#^https://#i',$serverUrl)) fail('Registration requires an https:// opnSentral URL.');
    if (!preg_match('/^[A-Za-z0-9_-]{40,128}$/',$token)) fail('Registration token format is invalid.');
    $response=http_post($serverUrl.'/api/agent_register.php',json_body(registration_payload($token)),[],true);
    save_config(['server_url'=>$serverUrl,'agent_id'=>(string)$response['agent_id'],'agent_secret'=>(string)$response['agent_secret'],'verify_tls'=>true,'poll_interval'=>max(30,(int)($response['poll_interval']??60))]);
    fwrite(STDOUT,"Registered with opnSentral as {$response['agent_id']}\n");
}

function load_opnsense_config(): array
{
    global $config;
    foreach (['/usr/local/etc/inc/util.inc','/usr/local/etc/inc/config.inc'] as $file) {
        if (!is_file($file)) throw new RuntimeException('Required OPNsense configuration library is missing: '.$file);
        require_once $file;
    }
    if (!is_array($config) && function_exists('parse_config')) $config=parse_config();
    if (!is_array($config)) throw new RuntimeException('OPNsense configuration is unavailable.');
    if (!function_exists('write_config')) throw new RuntimeException('OPNsense write_config() is unavailable.');
    return $config;
}

function config_list(mixed $value): array
{
    if ($value===null || $value==='') return [];
    $values=is_array($value)?$value:[$value]; $result=[];
    foreach ($values as $item) {
        if (is_array($item)) { foreach (config_list($item) as $nested) $result[]=$nested; continue; }
        $item=trim((string)$item); if ($item!=='') $result[]=$item;
    }
    return array_values(array_unique($result));
}

function config_bool(mixed $value): bool
{
    if ($value===null || $value==='' || $value===false || $value===0 || $value==='0') return false;
    if (is_string($value) && in_array(strtolower(trim($value)),['false','no','off'],true)) return false;
    return true;
}

function access_inventory_snapshot(): array
{
    load_opnsense_config(); global $config;
    $users=[];
    foreach (($config['system']['user']??[]) as $user) {
        if (!is_array($user)) continue;
        $name=trim((string)($user['name']??'')); if ($name==='') continue;
        $users[$name]=[
            'name'=>$name,
            'description'=>trim((string)($user['descr']??$user['description']??'')),
            'uid'=>trim((string)($user['uid']??'')),
            'scope'=>trim((string)($user['scope']??'user')),
            'groups'=>array_values(array_unique(array_merge(config_list($user['groupname']??null),config_list($user['group']??null)))),
            'privileges'=>array_values(array_unique(array_merge(config_list($user['priv']??null),config_list($user['privilege']??null)))),
            'shell'=>trim((string)($user['shell']??'')),
            'disabled'=>config_bool($user['disabled']??null),
            'otp'=>trim((string)($user['otp_seed']??''))!=='',
            'has_password'=>trim((string)($user['password']??''))!=='',
            'has_authorized_keys'=>trim((string)($user['authorizedkeys']??''))!=='',
        ];
    }
    $groups=[];
    foreach (($config['system']['group']??[]) as $group) {
        if (!is_array($group)) continue;
        $name=trim((string)($group['name']??'')); if ($name==='') continue;
        $groups[$name]=[
            'name'=>$name,
            'description'=>trim((string)($group['description']??$group['descr']??'')),
            'gid'=>trim((string)($group['gid']??'')),
            'scope'=>trim((string)($group['scope']??'system')),
            'members'=>array_values(array_unique(array_merge(config_list($group['member']??null),config_list($group['members']??null)))),
            'privileges'=>array_values(array_unique(array_merge(config_list($group['priv']??null),config_list($group['privilege']??null)))),
        ];
    }
    ksort($users,SORT_NATURAL|SORT_FLAG_CASE); ksort($groups,SORT_NATURAL|SORT_FLAG_CASE);
    if ($users===[] && $groups===[]) throw new RuntimeException('Local OPNsense config contains no System Access users or groups.');
    return ['ok'=>true,'users'=>$users,'groups'=>$groups,'collected_at'=>gmdate('c')];
}

function report(array $config): void
{
    $payload=['hostname'=>hostname_value(),'agent_version'=>AGENT_VERSION,'opnsense_version'=>opnsense_version(),'architecture'=>php_uname('m'),'platform'=>'opnsense','reported_at'=>gmdate('c')];
    try { $payload['access_inventory']=access_inventory_snapshot(); }
    catch (Throwable $exception) { $payload['access_inventory']=['ok'=>false,'error'=>substr($exception->getMessage(),0,500),'collected_at'=>gmdate('c')]; }
    signed_post($config,'/api/agent_report.php',$payload);
}

function self_update(array $config, array $payload): array
{
    $expected=strtolower(trim((string)($payload['sha256']??'')));
    if (!preg_match('/^[a-f0-9]{64}$/',$expected)) throw new RuntimeException('Self-update SHA-256 is missing or invalid.');
    $binary=curl_request(rtrim((string)$config['server_url'],'/').'/agent/opnsentral-agent','GET',null,[],($config['verify_tls']??true)!==false);
    if (strlen($binary)<1000 || !str_starts_with($binary,'#!/usr/local/bin/php')) throw new RuntimeException('Downloaded agent is invalid.');
    $actual=hash('sha256',$binary); if (!hash_equals($expected,$actual)) throw new RuntimeException('Downloaded agent SHA-256 does not match the deployment request.');
    if (!preg_match("/const AGENT_VERSION = '([^']+)'/",$binary,$match)) throw new RuntimeException('Downloaded agent does not declare a version.');
    $newVersion=(string)$match[1]; if (version_compare($newVersion,AGENT_VERSION,'<')) throw new RuntimeException('Refusing to downgrade agent.');
    $target='/usr/local/sbin/opnsentral-agent'; $temp=$target.'.new-'.bin2hex(random_bytes(4));
    if (file_put_contents($temp,$binary,LOCK_EX)===false) throw new RuntimeException('Could not write replacement agent.');
    chmod($temp,0755); if (!rename($temp,$target)) { @unlink($temp); throw new RuntimeException('Could not activate replacement agent.'); }
    return ['message'=>'Agent '.AGENT_VERSION.' updated to '.$newVersion.'.','previous_version'=>AGENT_VERSION,'new_version'=>$newVersion,'sha256'=>$actual,'_restart_agent'=>true];
}

function restore_backup(array $payload): array
{
    $backupId=(int)($payload['backup_id']??0); $filename=basename(trim((string)($payload['filename']??''))); $expected=strtolower(trim((string)($payload['sha256']??''))); $encoded=(string)($payload['content_b64']??'');
    if ($backupId<=0 || $filename==='' || !preg_match('/^[a-f0-9]{64}$/',$expected) || $encoded==='') throw new RuntimeException('Restore payload is incomplete.');
    $xml=base64_decode($encoded,true); if (!is_string($xml) || strlen($xml)<100) throw new RuntimeException('Restore backup content is invalid.');
    if (!hash_equals($expected,hash('sha256',$xml))) throw new RuntimeException('Restore backup SHA-256 verification failed.');
    libxml_use_internal_errors(true); $parsed=simplexml_load_string($xml,SimpleXMLElement::class,LIBXML_NONET|LIBXML_NOCDATA);
    if (!$parsed instanceof SimpleXMLElement || $parsed->getName()!=='opnsense') throw new RuntimeException('Restore backup is not a valid OPNsense configuration XML.');
    if (!is_dir('/conf') || !is_writable('/conf')) throw new RuntimeException('/conf is not writable.');
    if (!is_dir('/conf/backup') && !mkdir('/conf/backup',0700,true) && !is_dir('/conf/backup')) throw new RuntimeException('Could not create /conf/backup.');
    $safety='/conf/backup/opnsentral-before-emergency-restore-'.gmdate('Ymd-His').'.xml';
    if (is_file('/conf/config.xml') && !copy('/conf/config.xml',$safety)) throw new RuntimeException('Could not preserve current config before restore.');
    if (is_file($safety)) chmod($safety,0600);
    $temp='/conf/.opnsentral-restore-'.bin2hex(random_bytes(4)).'.xml';
    if (file_put_contents($temp,$xml,LOCK_EX)===false) throw new RuntimeException('Could not stage restored configuration.');
    chmod($temp,0600); if (!hash_equals($expected,(string)hash_file('sha256',$temp))) { @unlink($temp); throw new RuntimeException('Staged restore verification failed.'); }
    if (!rename($temp,'/conf/config.xml')) { @unlink($temp); throw new RuntimeException('Could not activate restored configuration.'); }
    chmod('/conf/config.xml',0600);
    return ['message'=>'Backup #'.$backupId.' restored to /conf/config.xml; reboot queued.','backup_id'=>$backupId,'filename'=>$filename,'sha256'=>$expected,'safety_copy'=>$safety,'restored_at'=>gmdate('c'),'_reboot_system'=>true];
}

function normalize_authorized_key(mixed $value): string
{
    if (!is_string($value)) throw new RuntimeException('Authorized Key must be text.');
    $value=trim(str_replace(["\r\n","\r"],"\n",$value));
    if ($value==='' || str_contains($value,"\n") || strlen($value)>8192 || preg_match('/[\x00-\x1F\x7F]/',$value)) throw new RuntimeException('Exactly one valid OpenSSH public key is required.');
    $parts=preg_split('/\s+/',$value,3)?:[];
    $allowed=['ssh-ed25519','ssh-rsa','ecdsa-sha2-nistp256','ecdsa-sha2-nistp384','ecdsa-sha2-nistp521','sk-ssh-ed25519@openssh.com','sk-ecdsa-sha2-nistp256@openssh.com'];
    $type=(string)($parts[0]??''); $blob=(string)($parts[1]??'');
    if (!in_array($type,$allowed,true) || $blob==='' || base64_decode($blob,true)===false) throw new RuntimeException('Unsupported or invalid OpenSSH public key.');
    return $value;
}

function add_access_user_authorized_key(array $payload): array
{
    $name=trim((string)($payload['user']??'')); $key=normalize_authorized_key($payload['authorized_key']??'');
    if ($name==='' || !preg_match('/^[^\x00-\x1F\x7F]{1,128}$/u',$name)) throw new RuntimeException('Invalid user name.');
    load_opnsense_config(); global $config;
    $authFile='/usr/local/etc/inc/auth.inc'; if (!is_file($authFile)) throw new RuntimeException('OPNsense Access library was not found.'); require_once $authFile;
    if (!isset($config['system']['user']) || !is_array($config['system']['user'])) throw new RuntimeException('OPNsense user configuration is unavailable.');
    $index=null;
    foreach ($config['system']['user'] as $candidateIndex=>$candidate) if (is_array($candidate) && (string)($candidate['name']??'')===$name) { $index=$candidateIndex; break; }
    if ($index===null) throw new RuntimeException('User not found on this OPNsense: '.$name);
    $user=$config['system']['user'][$index]; $existing=[]; $encoded=trim((string)($user['authorizedkeys']??''));
    if ($encoded!=='') {
        $decoded=base64_decode($encoded,true); if (!is_string($decoded)) throw new RuntimeException('Existing Authorized Keys value is invalid; refusing to overwrite it.');
        foreach (preg_split('/\R+/',trim($decoded))?:[] as $line) { $line=trim((string)$line); if ($line!=='') $existing[]=$line; }
    }
    $newParts=preg_split('/\s+/',$key,3)?:[]; $newIdentity=(string)($newParts[0]??'').' '.(string)($newParts[1]??'');
    foreach ($existing as $line) { $parts=preg_split('/\s+/',$line,3)?:[]; if (((string)($parts[0]??'').' '.(string)($parts[1]??''))===$newIdentity) return ['message'=>'SSH key is already present for user '.$name.'; no change made.','user'=>$name,'changed'=>false,'applied_at'=>gmdate('c')]; }
    if (!is_dir('/conf/backup') && !mkdir('/conf/backup',0700,true) && !is_dir('/conf/backup')) throw new RuntimeException('Could not create /conf/backup for safety copy.');
    $safety='/conf/backup/opnsentral-before-ssh-key-'.preg_replace('/[^A-Za-z0-9._-]+/','_',$name).'-'.gmdate('Ymd-His').'.xml';
    if (!is_file('/conf/config.xml') || !copy('/conf/config.xml',$safety)) throw new RuntimeException('Could not preserve /conf/config.xml before adding SSH key.');
    chmod($safety,0600);
    $existing[]=$key; $user['authorizedkeys']=base64_encode(implode("\n",$existing)); $config['system']['user'][$index]=$user;
    if (!function_exists('local_user_set')) throw new RuntimeException('Required OPNsense local_user_set() function is unavailable.');
    if (write_config('opnSentral: add Authorized Key to System Access user '.$name)===false) throw new RuntimeException('OPNsense write_config() rejected the change. Safety copy: '.$safety);
    local_user_set($user);
    if (!function_exists('load_config_from_file')) throw new RuntimeException('Post-write verification function is unavailable. Safety copy: '.$safety);
    $verify=load_config_from_file('/conf/config.xml'); $found=null;
    foreach (($verify['system']['user']??[]) as $candidate) if (is_array($candidate) && (string)($candidate['name']??'')===$name) { $found=$candidate; break; }
    if (!is_array($found)) throw new RuntimeException('Post-write verification failed: user disappeared from config. Safety copy: '.$safety);
    $verifyDecoded=base64_decode((string)($found['authorizedkeys']??''),true);
    if (!is_string($verifyDecoded) || !str_contains($verifyDecoded,(string)($newParts[1]??''))) throw new RuntimeException('Post-write verification failed: SSH key not present on disk. Safety copy: '.$safety);
    return ['message'=>'SSH key added to user '.$name.'. Existing keys and all other user settings were preserved.','user'=>$name,'changed'=>true,'safety_copy'=>$safety,'applied_at'=>gmdate('c')];
}

function execute_job(array $job, array $config): array
{
    $type=(string)($job['type']??'');
    if ($type==='inventory') return ['hostname'=>hostname_value(),'opnsense_version'=>opnsense_version(),'architecture'=>php_uname('m'),'php_version'=>PHP_VERSION,'agent_version'=>AGENT_VERSION,'access_inventory'=>access_inventory_snapshot()];
    if ($type==='system_status') { $load=function_exists('sys_getloadavg')?sys_getloadavg():[]; return ['hostname'=>hostname_value(),'load_average'=>is_array($load)?array_values($load):[],'uptime'=>trim((string)shell_exec('/usr/bin/uptime 2>/dev/null')),'checked_at'=>gmdate('c')]; }
    if ($type==='self_update') return self_update($config,is_array($job['payload']??null)?$job['payload']:[]);
    if ($type==='restore_backup') return restore_backup(is_array($job['payload']??null)?$job['payload']:[]);
    if ($type==='add_access_user_authorized_key') return add_access_user_authorized_key(is_array($job['payload']??null)?$job['payload']:[]);
    if ($type==='set_access_user') throw new RuntimeException('Broad System Access user writes are disabled. Use single-target Add SSH Key.');
    if (in_array($type,['set_administration_settings','set_general_settings','set_firewall_advanced_settings'],true)) throw new RuntimeException('Remote configuration writes are temporarily disabled for safety.');
    throw new RuntimeException('Unsupported job type: '.$type);
}

function schedule_system_reboot(): void
{
    shell_exec("/bin/sh -c '(sleep 3; /sbin/shutdown -r now) >/dev/null 2>&1 &' >/dev/null 2>&1");
}

function poll_job(array $config): bool
{
    $response=signed_post($config,'/api/agent_jobs.php',[]); $job=$response['job']??null;
    if (!is_array($job)) return false; $jobId=(int)($job['id']??0); if ($jobId<=0) return false;
    try {
        $result=execute_job($job,$config); $restart=($result['_restart_agent']??false)===true; $reboot=($result['_reboot_system']??false)===true;
        unset($result['_restart_agent'],$result['_reboot_system']);
        signed_post($config,'/api/agent_job_result.php',['job_id'=>$jobId,'success'=>true,'result'=>$result]); if ($reboot) schedule_system_reboot(); return $restart;
    } catch (Throwable $exception) {
        signed_post($config,'/api/agent_job_result.php',['job_id'=>$jobId,'success'=>false,'result'=>null,'error'=>$exception->getMessage()]); return false;
    }
}

function run_once(array $config): bool { report($config); return poll_job($config); }

$command=$argv[1]??'run';
if ($command==='register') { if (count($argv)<4) fail('Usage: opnsentral-agent register https://OPNSENTRAL TOKEN'); register_agent((string)$argv[2],(string)$argv[3]); exit(0); }
$agentConfig=load_config();
if ($command==='once') { run_once($agentConfig); exit(0); }
if ($command!=='run') fail('Supported commands: register, once, run');
$interval=max(30,(int)($agentConfig['poll_interval']??60));
while (true) {
    try { if (run_once($agentConfig)) exit(0); }
    catch (Throwable $exception) { fwrite(STDERR,gmdate('c').' '.$exception->getMessage()."\n"); }
    sleep($interval);
}
