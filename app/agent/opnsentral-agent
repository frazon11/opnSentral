    load_opnsense_config(); global $config;
    if (!isset($config['system']) || !is_array($config['system'])) $config['system'] = [];
    if (!isset($config['system']['webgui']) || !is_array($config['system']['webgui'])) $config['system']['webgui'] = [];
    $before = [];
    foreach ($changes as $key => $enabled) { $before[$key] = array_key_exists($key, $config['system']['webgui']); if ($enabled) $config['system']['webgui'][$key] = ''; else unset($config['system']['webgui'][$key]); }
    write_config('opnSentral: update System Settings Administration');
    run_local_command('/usr/local/sbin/configctl webgui restart', 'WebGUI restart');
    if (array_key_exists('disablehttpredirect', $changes)) run_local_command('/usr/local/sbin/configctl filter reload', 'Firewall reload');
    return ['message' => count($changes) . ' Administration setting' . (count($changes) === 1 ? '' : 's') . ' applied.', 'settings' => $changes, 'previous' => $before, 'applied_at' => gmdate('c')];
}

function fleet_presence(array &$target, string $key, bool $enabled): void
{
    if ($enabled) $target[$key] = ''; else unset($target[$key]);
}

function fleet_text(mixed $value, string $key, int $max = 255): string
{
    if (!is_string($value)) throw new RuntimeException('Setting ' . $key . ' must be text.');
    $value = trim($value);
    if (strlen($value) > $max || preg_match('/[\x00-\x1F\x7F]/', $value)) throw new RuntimeException('Invalid value for ' . $key . '.');
    return $value;
}

