BASE_PATH=/volume1/docker/opnsentral-telemetry
WEB_PORT=443
IMAGE_VERSION=latest
TZ=Europe/Brussels

# Public ingest API authentication is optional. Leave empty for the public
# anonymous telemetry endpoint used by standard opnSentral clients.
TELEMETRY_WRITE_TOKEN=

# Developer dashboard is enabled by default on the telemetry-server deployment
# and protected by HTTP Basic Auth.
TELEMETRY_DASHBOARD_ENABLED=true
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password

# Developer-only project statistics shown on the telemetry dashboard.
DOCKER_HUB_REPOSITORY=frazon11/opnsentral
GITHUB_TRAFFIC_REPOSITORY=frazon11/opnSentral
GITHUB_TRAFFIC_TOKEN=

# Delete installations not seen for this many days. 0 disables cleanup.
RETENTION_DAYS=730
