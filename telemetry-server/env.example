TZ=Europe/Brussels
TELEMETRY_WEB_PORT=8791
TELEMETRY_VERSION=latest

# Synology/Portainer host path for persistent telemetry data.
# Create this folder before deploying the stack.
TELEMETRY_BASE_PATH=/volume1/docker/opnsentral-telemetry

# Optional but recommended. When set, opnSentral clients must send the same token.
TELEMETRY_WRITE_TOKEN=replace-with-a-long-random-secret

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password

# Delete installations not seen for this many days. 0 disables cleanup.
RETENTION_DAYS=730
