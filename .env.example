BASE_PATH=/volume1/docker/opnsentral
WEB_PORT=8788
TZ=Europe/Brussels
APP_NAME=opnSentral

ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Generate with: openssl rand -hex 32
# Never change this after storing firewall credentials.
APP_KEY=REPLACE_WITH_64_HEX_CHARACTERS

SESSION_SECURE=false
DEFAULT_LANGUAGE=en

# Notifications
ALERTS_ENABLED=false
ALERT_VPN=true
ALERT_CHECK_INTERVAL=300
ALERT_FAILURE_THRESHOLD=2

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=opnSentral
NOTIFY_TO=

# Automatic pre-change backups retained per firewall
PRECHANGE_BACKUP_RETENTION=20

# Optional anonymous installation statistics
# Example: https://telemetry.example.com/api.php
TELEMETRY_URL=
TELEMETRY_WRITE_TOKEN=
