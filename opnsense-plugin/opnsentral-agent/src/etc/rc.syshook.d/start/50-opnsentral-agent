#!/bin/sh
# Ensure the opnSentral worker and trusted-host lockout guard are running after
# OPNsense boot/firmware upgrades. Re-apply trusted hosts before starting the
# services so protection does not depend on opnSentral connectivity.

SERVICE=/usr/sbin/service
LOCKOUT_HELPER=/usr/local/opnsense/scripts/OPNsense/OpnSentralAgent/sshlockout.php

if [ -x "$LOCKOUT_HELPER" ]; then
    "$LOCKOUT_HELPER" sync >/dev/null 2>&1 || true
fi

if [ -x /usr/local/opnsense/scripts/OPNsense/OpnSentralAgent/sshlockout_guard.sh ]; then
    $SERVICE opnsentral_lockout_guard onestatus >/dev/null 2>&1 || \
        $SERVICE opnsentral_lockout_guard start >/dev/null 2>&1 || true
fi

if [ ! -x /usr/local/sbin/opnsentral-agent ] || [ ! -s /usr/local/etc/opnsentral-agent.json ]; then
    exit 0
fi

$SERVICE opnsentral_agent onestatus >/dev/null 2>&1 && exit 0
$SERVICE opnsentral_agent start >/dev/null 2>&1 || true
exit 0
