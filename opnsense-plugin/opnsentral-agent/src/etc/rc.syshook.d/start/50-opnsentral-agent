#!/bin/sh
# Ensure the opnSentral worker is running after OPNsense boot/firmware upgrades.
# OPNsense executes executable scripts in rc.syshook.d/start near the end of startup.

SERVICE=/usr/sbin/service

if [ ! -x /usr/local/sbin/opnsentral-agent ] || [ ! -s /usr/local/etc/opnsentral-agent.json ]; then
    exit 0
fi

$SERVICE opnsentral_agent onestatus >/dev/null 2>&1 && exit 0
$SERVICE opnsentral_agent start >/dev/null 2>&1 || true
exit 0
